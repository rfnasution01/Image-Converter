# Recommended for production. Use the public HTTPS origin without a trailing path.
# Vercel deployments fall back to VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL when unset.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Optional. Only needed when features call a separate API.
NEXT_PUBLIC_API_URL=https://api.example.com

# Optional client error collector. Leave empty to disable remote reporting.
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=
