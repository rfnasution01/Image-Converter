{
  "id": "/",
  "name": "FileFlow - Private Image Converter",
  "short_name": "FileFlow",
  "description": "Convert JPG, PNG, and WebP images privately in your browser, with batch ZIP export and offline access after first visit.",
  "lang": "id-ID",
  "dir": "ltr",
  "categories": ["photo", "productivity", "utilities"],
  "icons": [
    {
      "src": "/favicon/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "theme_color": "#635bff",
  "background_color": "#f6fbff",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "start_url": "/?source=pwa",
